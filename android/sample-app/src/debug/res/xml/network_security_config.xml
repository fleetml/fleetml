<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plaintext to the local dev stack (the emulator
     reaches the host machine at 10.0.2.2, a phone over USB at localhost
     through adb reverse). Release builds keep the default (no cleartext). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- A phone over Wi-Fi: replace mac-lan-ip.invalid with the LAN
             address of the machine that runs the server (docs/ANDROID_SDK.md,
             "On your phone"). Without it the app registers, but every model
             download fails with "CLEARTEXT communication to <address> not
             permitted by network security policy". -->
        <domain includeSubdomains="false">mac-lan-ip.invalid</domain>
    </domain-config>
</network-security-config>
