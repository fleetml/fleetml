[Unit]
Description=FleetML device agent
Documentation=https://github.com/fleetml/fleetml/blob/main/docs/LINUX_AGENT.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/fleetml-agent -config /etc/fleetml-agent/config.yaml
Restart=always
RestartSec=5
User=fleetml-agent
Group=fleetml-agent
# /var/lib/fleetml-agent: registration, telemetry queue and models.
StateDirectory=fleetml-agent
StateDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
