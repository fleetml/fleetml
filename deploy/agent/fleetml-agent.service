[Unit]
Description=FleetML device agent
Documentation=https://github.com/fleetml/fleetml/blob/main/docs/LINUX_AGENT.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/fleetml-agent -config /etc/fleetml-agent/config.yaml
Restart=always
RestartSec=5
User=fleetml-agent
Group=fleetml-agent
# /var/lib/fleetml-agent: registration, telemetry queue and models.
StateDirectory=fleetml-agent
StateDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
# Keep this file as shipped: an upgrade replaces it. For a models_dir outside
# /var/lib/fleetml-agent, allow that folder in a drop-in, which upgrades keep:
# sudo systemctl edit fleetml-agent, then [Service] and ReadWritePaths=<folder>
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
