DATABASE_URL=postgres://fleetml:fleetml_dev@localhost:15432/fleetml?sslmode=disable
S3_ENDPOINT=localhost:19000
S3_BUCKET=fleetml-models
S3_ACCESS_KEY=fleetml
S3_SECRET_KEY=fleetml-dev-secret
S3_USE_SSL=false
# Address devices use for model downloads, if different (Android emulator: 10.0.2.2:19000).
# S3_PUBLIC_ENDPOINT=10.0.2.2:19000
NATS_URL=nats://localhost:14222
GRPC_PORT=19090
REST_PORT=18080
# Signs device tokens; at least 32 characters. `make dev` puts a random one in .env.
JWT_SECRET=
LOG_LEVEL=debug
LOG_FORMAT=json

# Admin API key for the REST API, stored (hashed) on first start if no key exists yet.
# `make dev` appends a random one when it creates .env. If unset, the server generates
# one on first start and prints it once in its log (look for admin_api_key).
# FLEETML_ADMIN_KEY=

# Docker compose port mappings (host ports)
FLEETML_PG_PORT=15432
FLEETML_NATS_PORT=14222
FLEETML_NATS_MONITOR_PORT=18222
FLEETML_S3_PORT=19000
